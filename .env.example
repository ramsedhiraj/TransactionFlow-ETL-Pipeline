# ==============================================================================
# TransactionFlow Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (Default: PostgreSQL)
# For local testing without Postgres, SQLite is supported: sqlite:///./data/transactionflow.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/transactionflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_TIMEOUT=30

# ETL Batch Processing Defaults
DEFAULT_BATCH_SIZE=10000
MAX_WORKERS=4

# Suspicious Risk Rule Thresholds
RISK_HIGH_AMOUNT_THRESHOLD=10000.00
RISK_VELOCITY_WINDOW_MINUTES=5
RISK_VELOCITY_MAX_COUNT=3
RISK_RAPID_IDENTICAL_WINDOW_SECONDS=60
RISK_ATM_CATEGORY_THRESHOLD=2000.00

# REST API Ingestion Settings
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=10.0
API_MAX_RETRIES=4
API_BACKOFF_FACTOR=1.5
API_PAGE_SIZE=500
API_RATE_LIMIT_RPS=20

# Optional Azure Storage / ADLS Gen2 Configuration
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=transactions-raw
AZURE_ADLS_ACCOUNT_NAME=
AZURE_USE_MANAGED_IDENTITY=false
